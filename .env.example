NODE_ENV=development
API_PORT=4000
ALLOWED_ORIGINS=http://localhost:5173
TRUST_PROXY=false
API_PUBLIC_BASE_URL=http://localhost:4000/api/v1
WEB_PUBLIC_BASE_URL=http://localhost:5173
VITE_API_BASE_URL=http://localhost:4000/api/v1
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/odyssey
JWT_SECRET=replace-this-in-development
JWT_ISSUER=project-odyssey-api
JWT_AUDIENCE=project-odyssey-clients
JWT_ACCESS_TTL_SECONDS=900
ODYSSEY_INTELLIGENCE_ENABLED=true
ODYSSEY_INTELLIGENCE_SERVICE_URL=http://localhost:8000
ODYSSEY_INTELLIGENCE_TIMEOUT_MS=2000

# Governed G6 demo: set secret values only in ignored .env.
# ODYSSEY_DEMO_ADMIN_EMAIL=admin@odyssey.local
# ODYSSEY_DEMO_ADMIN_PASSWORD=replace-locally
# ODYSSEY_DEMO_OFFICER_PRIMARY_PASSWORD=replace-locally
# ODYSSEY_DEMO_OFFICER_VERIFIER_PASSWORD=replace-locally
# ODYSSEY_DEMO_OFFICER_CLOSER_PASSWORD=replace-locally
# ODYSSEY_DEMO_POLICY_ADMIN_PASSWORD=replace-locally
# ODYSSEY_DEMO_AUDITOR_PASSWORD=replace-locally
# ODYSSEY_API_BASE_URL=http://localhost:4000/api/v1
# ODYSSEY_DEMO_DEPARTMENT_CODE=PWD
# ODYSSEY_DEMO_JURISDICTION_NAME=Pune Division

# Optional isolated C6 Playwright credential; synthetic schema only.
# C6_E2E_PASSWORD=replace-locally
