# Copy to an ignored .env.pilot and replace every replace-* value.
ODYSSEY_DB_USER=odyssey
ODYSSEY_DB_NAME=odyssey
ODYSSEY_DB_PASSWORD=replace-with-url-safe-database-password
ODYSSEY_DATABASE_URL=postgresql://odyssey:replace-with-url-safe-database-password@db:5432/odyssey
JWT_SECRET=replace-with-a-long-random-secret
JWT_ISSUER=project-odyssey-api
JWT_AUDIENCE=project-odyssey-clients
JWT_ACCESS_TTL_SECONDS=900
ODYSSEY_WEB_ORIGIN=http://localhost:8080
ODYSSEY_WEB_PORT=8080
ODYSSEY_API_PORT=4000
ODYSSEY_INTELLIGENCE_TIMEOUT_MS=2000
