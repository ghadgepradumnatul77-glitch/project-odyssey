# Copy to an ignored .env.pilot and replace every replace-* value.
ODYSSEY_DB_NAME=odyssey
ODYSSEY_POSTGRES_MAJOR=16
ODYSSEY_DB_OWNER_USER=odyssey_owner
ODYSSEY_DB_OWNER_PASSWORD=replace-with-url-safe-owner-password
ODYSSEY_DB_OWNER_DATABASE_URL=postgresql://odyssey_owner:replace-with-url-safe-owner-password@db:5432/odyssey
ODYSSEY_DB_MIGRATION_USER=odyssey_migration
ODYSSEY_DB_MIGRATION_PASSWORD=replace-with-url-safe-migration-password
ODYSSEY_DB_MIGRATION_DATABASE_URL=postgresql://odyssey_migration:replace-with-url-safe-migration-password@db:5432/odyssey
ODYSSEY_DB_RUNTIME_USER=odyssey_runtime
ODYSSEY_DB_RUNTIME_PASSWORD=replace-with-url-safe-runtime-password
ODYSSEY_DB_RUNTIME_DATABASE_URL=postgresql://odyssey_runtime:replace-with-url-safe-runtime-password@db:5432/odyssey
ODYSSEY_DB_BACKUP_USER=odyssey_backup
ODYSSEY_DB_BACKUP_PASSWORD=replace-with-url-safe-backup-password
ODYSSEY_DB_BACKUP_DATABASE_URL=postgresql://odyssey_backup:replace-with-url-safe-backup-password@db:5432/odyssey
ODYSSEY_BACKUP_DIRECTORY=C:/secure/odyssey-backups
ODYSSEY_PILOT_READINESS_FILE=.pilot-readiness.json
JWT_SECRET=replace-with-a-long-random-secret
JWT_ISSUER=project-odyssey-api
JWT_AUDIENCE=project-odyssey-clients
JWT_ACCESS_TTL_SECONDS=900
ODYSSEY_ALLOWED_ORIGINS=http://localhost:8080
ODYSSEY_API_PUBLIC_BASE_URL=http://localhost:8080/api/v1
ODYSSEY_WEB_PUBLIC_BASE_URL=http://localhost:8080
ODYSSEY_TRUST_PROXY=false
ODYSSEY_WEB_BIND_HOST=127.0.0.1
ODYSSEY_API_BIND_HOST=127.0.0.1
ODYSSEY_WEB_PORT=8080
ODYSSEY_API_PORT=4000
ODYSSEY_INTELLIGENCE_ENABLED=false
ODYSSEY_INTELLIGENCE_SERVICE_URL=http://ai:8000
ODYSSEY_INTELLIGENCE_TIMEOUT_MS=2000
ODYSSEY_WEATHER_PROVIDER_ENABLED=false
ODYSSEY_WEATHER_PROVIDER_DEPLOYMENT_CLASS=DISABLED
