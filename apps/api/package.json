{
  "name": "odyssey-api",
  "private": true,
  "scripts": {
    "dev": "npm run build && node scripts/start-runtime.cjs",
    "build": "node scripts/build-runtime.cjs",
    "start": "node scripts/start-runtime.cjs",
    "test": "vitest run",
    "demo": "node --experimental-strip-types scripts/bootstrap-demo.ts --public-reports-only",
    "demo:bootstrap": "node --experimental-transform-types scripts/governed-demo.ts",
    "demo:bootstrap:legacy": "tsx scripts/bootstrap-demo.ts",
    "demo:verify": "node --experimental-transform-types scripts/governed-demo.ts --verify",
    "demo:geo": "node --experimental-strip-types scripts/enrich-demo-geolocation.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.0.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.0.0",
    "jose": "^6.1.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "@types/supertest": "^6.0.3",
    "prisma": "^6.0.0",
    "supertest": "^7.1.4",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.2.4"
  }
}
