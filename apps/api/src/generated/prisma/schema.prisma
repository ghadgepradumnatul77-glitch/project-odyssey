generator client {
  provider = "prisma-client-js"
  output   = "../../apps/api/src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum SystemRole {
  OFFICER
  POLICY_ADMIN
  AUDITOR
  SYSTEM_ADMIN
}

enum AssetType {
  BRIDGE
  ROAD
  FLYOVER
}

enum CaseStatus {
  NEW
  INSPECTION_REQUIRED
  INSPECTION_IN_PROGRESS
  UNDER_ANALYSIS
  ORP_READY
  UNDER_REVIEW
  APPROVED
  EXECUTION
  VERIFICATION
  CLOSED
  CANCELLED
}

enum RiskLevel {
  VERY_LOW
  LOW
  MODERATE
  HIGH
  VERY_HIGH
  CRITICAL
}

enum PriorityLevel {
  LOW
  MEDIUM
  HIGH
  VERY_HIGH
  CRITICAL
}

enum OrpDecisionType {
  APPROVED
  REJECTED
  MODIFICATION_REQUESTED
  REINSPECTION_REQUESTED
  ESCALATED
}

enum ExecutionPlanStatus {
  PLANNED
  IN_PROGRESS
  VERIFICATION_PENDING
  COMPLETED
  CANCELLED
}

enum ExecutionTaskStatus {
  PENDING
  ASSIGNED
  IN_PROGRESS
  BLOCKED
  COMPLETION_SUBMITTED
  VERIFIED
  CANCELLED
}

enum ExecutionEvidenceType {
  PHOTO_REFERENCE
  DOCUMENT_REFERENCE
  MEASUREMENT
  COMPLETION_NOTE
  INSPECTION_REPORT
  OTHER
}

enum CaseClosureReason {
  EXECUTION_VERIFIED
}

enum PublicReportStatus {
  SUBMITTED
  UNDER_REVIEW
  ACCEPTED
  REJECTED
}

enum PublicReportCategory {
  ROAD_DAMAGE
  BRIDGE_OR_FLYOVER
  WATERLOGGING
  STREETLIGHT
  DRAINAGE
  PUBLIC_BUILDING
  OTHER
}

enum PublicReportTriageUrgency {
  LOW
  MODERATE
  HIGH
  URGENT
}

enum RegistryLifecycleStatus {
  DRAFT
  VALIDATION
  APPROVED
  ACTIVE
  SUPERSEDED
  ARCHIVED
}

enum PolicyValidationState {
  NOT_VALIDATED
  VALIDATED
  REJECTED
}

enum EnforcementClassification {
  MANDATORY
  RECOMMENDED
  OPTIONAL
  PROHIBITED
}

enum DecisionPackageStatus {
  PREPARED
  SUPERSEDED
}

enum ActionPlanGovernanceMode {
  LEGACY
  GOVERNED_POLICY
  GOVERNED_ENGINEERING_NO_POLICY
}

enum ExecutionPlanGovernanceMode {
  LEGACY
  GOVERNED
}

model Department {
  id                         String                      @id @default(uuid())
  name                       String
  code                       String                      @unique
  users                      User[]
  assets                     Asset[]
  jurisdictions              Jurisdiction[]
  approvalAuthorities        ApprovalAuthority[]
  publicReports              PublicReport[]
  policyDocuments            PolicyDocument[]
  approvedActions            ApprovedActionVersion[]
  governedExecutionTemplates GovernedExecutionTemplate[]
  createdAt                  DateTime                    @default(now())
}

model Jurisdiction {
  id                         String                      @id @default(uuid())
  name                       String
  type                       String
  departmentId               String
  department                 Department                  @relation(fields: [departmentId], references: [id])
  users                      User[]
  assets                     Asset[]
  approvalAuthorities        ApprovalAuthority[]
  publicReports              PublicReport[]
  policyDocuments            PolicyDocument[]
  approvedActions            ApprovedActionVersion[]
  governedExecutionTemplates GovernedExecutionTemplate[]
  createdAt                  DateTime                    @default(now())

  @@index([departmentId])
}

model User {
  id           String     @id @default(uuid())
  employeeCode String     @unique
  name         String
  email        String     @unique
  passwordHash String
  designation  String
  role         SystemRole @default(OFFICER)
  status       UserStatus @default(ACTIVE)

  departmentId   String
  jurisdictionId String

  department   Department   @relation(fields: [departmentId], references: [id])
  jurisdiction Jurisdiction @relation(fields: [jurisdictionId], references: [id])

  inspections                        Inspection[]
  approvalAuthorities                ApprovalAuthority[]
  reviewedOrpDecisions               OrpDecision[]                @relation("DecisionReviewer")
  forwardedOrpDecisions              OrpDecision[]                @relation("DecisionForwardedUser")
  createdExecutionPlans              ExecutionPlan[]              @relation("ExecutionPlanCreator")
  assignedExecutionTasks             ExecutionTask[]              @relation("ExecutionTaskAssignee")
  assignedByExecutionTasks           ExecutionTask[]              @relation("ExecutionTaskAssigner")
  completedExecutionTasks            ExecutionTask[]              @relation("ExecutionTaskCompleter")
  verifiedExecutionTasks             ExecutionTask[]              @relation("ExecutionTaskVerifier")
  cancelledExecutionTasks            ExecutionTask[]              @relation("ExecutionTaskCanceller")
  submittedExecutionEvidence         ExecutionEvidence[]
  closedCases                        CaseClosure[]                @relation("CaseClosureCloser")
  reviewedPublicReports              PublicReport[]               @relation("PublicReportReviewer")
  decidedPublicReports               PublicReport[]               @relation("PublicReportDecisionActor")
  createdTriageAnalyses              PublicReportTriageAnalysis[]
  createdPolicyDocuments             PolicyDocument[]             @relation("PolicyDocumentCreator")
  approvedPolicyDocuments            PolicyDocument[]             @relation("PolicyDocumentApprover")
  createdApprovedActions             ApprovedActionVersion[]      @relation("ApprovedActionCreator")
  approvedApprovedActions            ApprovedActionVersion[]      @relation("ApprovedActionApprover")
  preparedDecisionPackages           DecisionPackage[]            @relation("DecisionPackagePreparer")
  createdGovernedExecutionTemplates  GovernedExecutionTemplate[]  @relation("GovernedExecutionTemplateCreator")
  approvedGovernedExecutionTemplates GovernedExecutionTemplate[]  @relation("GovernedExecutionTemplateApprover")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([departmentId])
  @@index([jurisdictionId])
  @@index([role])
  @@index([status])
}

model Asset {
  id        String    @id @default(uuid())
  assetCode String    @unique
  name      String
  assetType AssetType

  departmentId   String
  jurisdictionId String

  latitude  Decimal? @db.Decimal(9, 6)
  longitude Decimal? @db.Decimal(9, 6)

  constructionYear Int?
  conditionStatus  String?

  department   Department   @relation(fields: [departmentId], references: [id])
  jurisdiction Jurisdiction @relation(fields: [jurisdictionId], references: [id])

  cases                      Case[]
  publicReports              PublicReport[]
  suggestedForTriageAnalyses PublicReportTriageAnalysis[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([departmentId])
  @@index([jurisdictionId])
  @@index([assetType])
}

model PublicReport {
  id              String                       @id @default(uuid())
  reportNumber    String                       @unique
  title           String
  description     String
  category        PublicReportCategory
  locationText    String
  latitude        Decimal?                     @db.Decimal(9, 6)
  longitude       Decimal?                     @db.Decimal(9, 6)
  reporterName    String?
  reporterContact String?
  submittedAt     DateTime                     @default(now())
  status          PublicReportStatus           @default(SUBMITTED)
  departmentId    String?
  jurisdictionId  String?
  assetId         String?
  reviewStartedAt DateTime?
  reviewedById    String?
  decisionAt      DateTime?
  decisionById    String?
  rejectionReason String?
  createdCaseId   String?                      @unique
  department      Department?                  @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  jurisdiction    Jurisdiction?                @relation(fields: [jurisdictionId], references: [id], onDelete: SetNull)
  asset           Asset?                       @relation(fields: [assetId], references: [id], onDelete: SetNull)
  reviewedBy      User?                        @relation("PublicReportReviewer", fields: [reviewedById], references: [id], onDelete: Restrict)
  decisionBy      User?                        @relation("PublicReportDecisionActor", fields: [decisionById], references: [id], onDelete: Restrict)
  createdCase     Case?                        @relation("PublicReportCreatedCase", fields: [createdCaseId], references: [id], onDelete: Restrict)
  triageAnalyses  PublicReportTriageAnalysis[]
  createdAt       DateTime                     @default(now())
  updatedAt       DateTime                     @updatedAt

  @@index([status])
  @@index([category])
  @@index([submittedAt])
  @@index([departmentId, jurisdictionId])
  @@index([assetId])
  @@index([reviewedById])
  @@index([decisionById])
}

model PublicReportTriageAnalysis {
  id                  String                    @id @default(uuid())
  publicReportId      String
  analysisVersion     String
  suggestedCategory   PublicReportCategory
  urgencyLevel        PublicReportTriageUrgency
  confidence          Int
  reasonCodes         Json
  reasons             Json
  possibleAssetId     String?
  duplicateCandidates Json
  createdById         String
  publicReport        PublicReport              @relation(fields: [publicReportId], references: [id], onDelete: Restrict)
  possibleAsset       Asset?                    @relation(fields: [possibleAssetId], references: [id], onDelete: SetNull)
  createdBy           User                      @relation(fields: [createdById], references: [id], onDelete: Restrict)
  createdAt           DateTime                  @default(now())

  @@unique([publicReportId, analysisVersion])
  @@index([publicReportId, createdAt])
  @@index([possibleAssetId])
  @@index([createdById])
}

model PolicyDocument {
  id              String                  @id @default(uuid())
  policyCode      String
  versionNumber   Int
  title           String
  sourceTitle     String
  sourceReference String
  sourceUrl       String?
  departmentId    String?
  jurisdictionId  String?
  effectiveFrom   DateTime
  effectiveUntil  DateTime?
  status          RegistryLifecycleStatus @default(DRAFT)
  validationState PolicyValidationState   @default(NOT_VALIDATED)
  createdById     String
  approvedById    String?
  approvedAt      DateTime?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  department       Department?             @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  jurisdiction     Jurisdiction?           @relation(fields: [jurisdictionId], references: [id], onDelete: Restrict)
  createdBy        User                    @relation("PolicyDocumentCreator", fields: [createdById], references: [id], onDelete: Restrict)
  approvedBy       User?                   @relation("PolicyDocumentApprover", fields: [approvedById], references: [id], onDelete: Restrict)
  rules            PolicyRule[]
  actionProvenance ApprovedActionVersion[]

  @@unique([policyCode, versionNumber])
  @@index([status, effectiveFrom, effectiveUntil])
  @@index([departmentId, jurisdictionId])
  @@index([createdById])
  @@index([approvedById])
}

model ApprovedActionVersion {
  id                         String                    @id @default(uuid())
  actionCode                 String
  versionNumber              Int
  title                      String
  category                   String
  description                String
  applicability              Json
  enforcementClassification  EnforcementClassification
  provenancePolicyDocumentId String?
  sourceReference            String
  departmentId               String?
  jurisdictionId             String?
  effectiveFrom              DateTime
  effectiveUntil             DateTime?
  status                     RegistryLifecycleStatus   @default(DRAFT)
  createdById                String
  approvedById               String?
  approvedAt                 DateTime?
  createdAt                  DateTime                  @default(now())
  updatedAt                  DateTime                  @updatedAt

  provenancePolicyDocument PolicyDocument?             @relation(fields: [provenancePolicyDocumentId], references: [id], onDelete: Restrict)
  department               Department?                 @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  jurisdiction             Jurisdiction?               @relation(fields: [jurisdictionId], references: [id], onDelete: Restrict)
  createdBy                User                        @relation("ApprovedActionCreator", fields: [createdById], references: [id], onDelete: Restrict)
  approvedBy               User?                       @relation("ApprovedActionApprover", fields: [approvedById], references: [id], onDelete: Restrict)
  rules                    PolicyRule[]
  executionTemplates       GovernedExecutionTemplate[]
  executionTasks           ExecutionTask[]

  @@unique([actionCode, versionNumber])
  @@index([status, effectiveFrom, effectiveUntil])
  @@index([departmentId, jurisdictionId])
  @@index([provenancePolicyDocumentId])
  @@index([createdById])
  @@index([approvedById])
}

model GovernedExecutionTemplate {
  id                      String                  @id @default(uuid())
  templateCode            String
  versionNumber           Int
  approvedActionVersionId String
  title                   String
  description             String
  status                  RegistryLifecycleStatus @default(DRAFT)
  effectiveFrom           DateTime
  effectiveUntil          DateTime?
  departmentId            String?
  jurisdictionId          String?
  createdById             String
  approvedById            String?
  approvedAt              DateTime?
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt

  approvedActionVersion ApprovedActionVersion           @relation(fields: [approvedActionVersionId], references: [id], onDelete: Restrict)
  department            Department?                     @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  jurisdiction          Jurisdiction?                   @relation(fields: [jurisdictionId], references: [id], onDelete: Restrict)
  createdBy             User                            @relation("GovernedExecutionTemplateCreator", fields: [createdById], references: [id], onDelete: Restrict)
  approvedBy            User?                           @relation("GovernedExecutionTemplateApprover", fields: [approvedById], references: [id], onDelete: Restrict)
  tasks                 GovernedExecutionTaskTemplate[]
  executionTasks        ExecutionTask[]

  @@unique([templateCode, versionNumber])
  @@index([approvedActionVersionId, status, effectiveFrom, effectiveUntil])
  @@index([departmentId, jurisdictionId])
  @@index([createdById])
  @@index([approvedById])
}

model GovernedExecutionTaskTemplate {
  id                   String   @id @default(uuid())
  executionTemplateId  String
  sequenceNumber       Int
  taskCode             String
  title                String
  description          String
  mandatory            Boolean  @default(true)
  evidenceRequired     Boolean  @default(true)
  verificationRequired Boolean  @default(true)
  enabled              Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  executionTemplate GovernedExecutionTemplate @relation(fields: [executionTemplateId], references: [id], onDelete: Restrict)
  executionTasks    ExecutionTask[]

  @@unique([executionTemplateId, sequenceNumber])
  @@unique([executionTemplateId, taskCode])
  @@index([executionTemplateId, enabled])
}

model PolicyRule {
  id               String                    @id @default(uuid())
  policyDocumentId String
  ruleCode         String
  description      String
  conditions       Json
  actionId         String
  enforcementLevel EnforcementClassification
  enabled          Boolean                   @default(true)
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt

  policyDocument PolicyDocument        @relation(fields: [policyDocumentId], references: [id], onDelete: Restrict)
  action         ApprovedActionVersion @relation(fields: [actionId], references: [id], onDelete: Restrict)

  @@unique([policyDocumentId, ruleCode])
  @@index([actionId])
  @@index([enforcementLevel])
}

model Case {
  id          String  @id @default(uuid())
  caseNumber  String  @unique
  assetId     String
  title       String
  description String?

  status        CaseStatus     @default(NEW)
  riskLevel     RiskLevel?
  priorityLevel PriorityLevel?

  emergencyFlag Boolean @default(false)

  asset                    Asset                     @relation(fields: [assetId], references: [id])
  inspections              Inspection[]
  riskAssessments          RiskAssessment[]
  operationalResponsePlans OperationalResponsePlan[]
  orpDecisions             OrpDecision[]
  executionPlans           ExecutionPlan[]
  closure                  CaseClosure?
  sourcePublicReport       PublicReport?             @relation("PublicReportCreatedCase")
  decisionPackages         DecisionPackage[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  closedAt  DateTime?

  @@index([status])
  @@index([priorityLevel])
  @@index([riskLevel])
  @@index([assetId])
}

model Inspection {
  id          String @id @default(uuid())
  caseId      String
  inspectorId String

  inspectionDate DateTime

  structuralCondition String
  crackSeverity       String
  corrosionLevel      String

  trafficImportance String
  hospitalRoute     Boolean

  weatherRisk       String
  heavyRainExpected Boolean

  estimatedDailyUsers Int?
  inspectionNotes     String?

  case             Case              @relation(fields: [caseId], references: [id])
  inspector        User              @relation(fields: [inspectorId], references: [id])
  riskAssessments  RiskAssessment[]
  decisionPackages DecisionPackage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([caseId])
  @@index([inspectorId])
}

model RiskAssessment {
  id                String        @id @default(uuid())
  caseId            String
  inspectionId      String
  riskScore         Int
  riskLevel         RiskLevel
  priorityLevel     PriorityLevel
  reasonCodes       Json
  reasons           Json
  assessmentVersion String        @default("ODYSSEY_RISK_V1")
  createdAt         DateTime      @default(now())

  case                     Case                      @relation(fields: [caseId], references: [id], onDelete: Cascade)
  inspection               Inspection                @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  operationalResponsePlans OperationalResponsePlan[]
  decisionPackages         DecisionPackage[]

  @@index([caseId])
  @@index([inspectionId])
}

model OperationalResponsePlan {
  id                        String                   @id @default(uuid())
  caseId                    String
  riskAssessmentId          String
  versionNumber             Int
  status                    String                   @default("AWAITING_REVIEW")
  urgency                   String
  recommendedActionCodes    Json
  temporaryMeasures         Json
  reasons                   Json
  alternativeActionCodes    Json
  planVersion               String                   @default("ODYSSEY_ORP_V1")
  createdAt                 DateTime                 @default(now())
  updatedAt                 DateTime                 @updatedAt
  decisionPackageId         String?
  governanceMode            ActionPlanGovernanceMode @default(LEGACY)
  governedActions           Json?
  actionPlanContractVersion String?

  case            Case             @relation(fields: [caseId], references: [id], onDelete: Cascade)
  riskAssessment  RiskAssessment   @relation(fields: [riskAssessmentId], references: [id], onDelete: Cascade)
  decisions       OrpDecision[]
  executionPlan   ExecutionPlan?
  decisionPackage DecisionPackage? @relation(fields: [decisionPackageId], references: [id], onDelete: Restrict)

  @@unique([caseId, versionNumber])
  @@index([caseId])
  @@index([riskAssessmentId])
  @@index([decisionPackageId])
  @@index([governanceMode])
}

model DecisionPackage {
  id                     String                @id @default(uuid())
  caseId                 String
  inspectionId           String
  riskAssessmentId       String
  packageVersion         Int
  packageContractVersion String                @default("ODYSSEY_DECISION_PACKAGE_V1")
  status                 DecisionPackageStatus @default(PREPARED)
  sourceFingerprint      String
  caseSnapshot           Json
  inspectionSnapshot     Json
  riskSnapshot           Json
  readinessSnapshot      Json
  policySnapshot         Json
  actionSnapshot         Json
  preparedById           String
  preparedAt             DateTime              @default(now())
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt

  case           Case                      @relation(fields: [caseId], references: [id], onDelete: Restrict)
  inspection     Inspection                @relation(fields: [inspectionId], references: [id], onDelete: Restrict)
  riskAssessment RiskAssessment            @relation(fields: [riskAssessmentId], references: [id], onDelete: Restrict)
  preparedBy     User                      @relation("DecisionPackagePreparer", fields: [preparedById], references: [id], onDelete: Restrict)
  responsePlans  OperationalResponsePlan[]

  @@unique([caseId, packageVersion])
  @@unique([caseId, sourceFingerprint])
  @@index([caseId, status, packageVersion])
  @@index([inspectionId])
  @@index([riskAssessmentId])
  @@index([preparedById])
  @@index([preparedAt])
}

model ApprovalAuthority {
  id             String @id @default(uuid())
  userId         String
  departmentId   String
  jurisdictionId String

  canApprove             Boolean @default(false)
  canReject              Boolean @default(false)
  canRequestModification Boolean @default(false)
  canRequestReinspection Boolean @default(false)
  canEscalate            Boolean @default(false)
  canCloseCase           Boolean @default(false)

  maxPriorityLevel PriorityLevel?
  isActive         Boolean        @default(true)
  validFrom        DateTime?
  validUntil       DateTime?

  user         User          @relation(fields: [userId], references: [id])
  department   Department    @relation(fields: [departmentId], references: [id])
  jurisdiction Jurisdiction  @relation(fields: [jurisdictionId], references: [id])
  decisions    OrpDecision[]
  caseClosures CaseClosure[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([departmentId])
  @@index([jurisdictionId])
  @@index([isActive])
}

model OrpDecision {
  id               String          @id @default(uuid())
  caseId           String
  orpId            String          @unique
  reviewerId       String
  authorityGrantId String
  decisionType     OrpDecisionType
  reason           String?
  remarks          String?
  requestedChanges Json?
  forwardToUserId  String?
  createdAt        DateTime        @default(now())

  case           Case                    @relation(fields: [caseId], references: [id], onDelete: Restrict)
  orp            OperationalResponsePlan @relation(fields: [orpId], references: [id], onDelete: Restrict)
  reviewer       User                    @relation("DecisionReviewer", fields: [reviewerId], references: [id], onDelete: Restrict)
  authorityGrant ApprovalAuthority       @relation(fields: [authorityGrantId], references: [id], onDelete: Restrict)
  forwardedUser  User?                   @relation("DecisionForwardedUser", fields: [forwardToUserId], references: [id], onDelete: Restrict)
  executionPlan  ExecutionPlan?

  @@index([caseId])
  @@index([reviewerId])
  @@index([authorityGrantId])
  @@index([forwardToUserId])
  @@index([decisionType])
  @@index([createdAt])
}

model ExecutionPlan {
  id                       String                      @id @default(uuid())
  orpId                    String                      @unique
  caseId                   String
  approvalDecisionId       String                      @unique
  status                   ExecutionPlanStatus         @default(PLANNED)
  createdById              String
  templateVersion          String                      @default("ODYSSEY_EXECUTION_V1")
  createdAt                DateTime                    @default(now())
  updatedAt                DateTime                    @updatedAt
  startedAt                DateTime?
  completedAt              DateTime?
  cancelledAt              DateTime?
  cancellationReason       String?
  governanceMode           ExecutionPlanGovernanceMode @default(LEGACY)
  executionContractVersion String?
  governedProvenance       Json?

  orp              OperationalResponsePlan @relation(fields: [orpId], references: [id], onDelete: Restrict)
  case             Case                    @relation(fields: [caseId], references: [id], onDelete: Restrict)
  approvalDecision OrpDecision             @relation(fields: [approvalDecisionId], references: [id], onDelete: Restrict)
  createdBy        User                    @relation("ExecutionPlanCreator", fields: [createdById], references: [id], onDelete: Restrict)
  tasks            ExecutionTask[]
  closure          CaseClosure?

  @@index([caseId])
  @@index([status])
  @@index([createdById])
}

model ExecutionTask {
  id                          String              @id @default(uuid())
  executionPlanId             String
  sequenceNumber              Int
  sourceActionCode            String
  templateTaskKey             String
  titleSnapshot               String
  descriptionSnapshot         String
  categorySnapshot            String
  isMandatory                 Boolean             @default(true)
  status                      ExecutionTaskStatus @default(PENDING)
  assignedToId                String?
  assignedById                String?
  assignedAt                  DateTime?
  startedAt                   DateTime?
  completionSubmittedById     String?
  completionSubmittedAt       DateTime?
  completionNote              String?
  verifiedById                String?
  verifiedAt                  DateTime?
  verificationNote            String?
  blockedReason               String?
  cancelledById               String?
  cancelledAt                 DateTime?
  cancellationReason          String?
  createdAt                   DateTime            @default(now())
  updatedAt                   DateTime            @updatedAt
  approvedActionVersionId     String?
  governedExecutionTemplateId String?
  governedTaskTemplateId      String?
  sourceActionVersion         Int?
  sourceTemplateCode          String?
  sourceTemplateVersion       Int?
  evidenceRequired            Boolean             @default(true)
  verificationRequired        Boolean             @default(true)

  executionPlan             ExecutionPlan                  @relation(fields: [executionPlanId], references: [id], onDelete: Restrict)
  assignedTo                User?                          @relation("ExecutionTaskAssignee", fields: [assignedToId], references: [id], onDelete: Restrict)
  assignedBy                User?                          @relation("ExecutionTaskAssigner", fields: [assignedById], references: [id], onDelete: Restrict)
  completionSubmittedBy     User?                          @relation("ExecutionTaskCompleter", fields: [completionSubmittedById], references: [id], onDelete: Restrict)
  verifiedBy                User?                          @relation("ExecutionTaskVerifier", fields: [verifiedById], references: [id], onDelete: Restrict)
  cancelledBy               User?                          @relation("ExecutionTaskCanceller", fields: [cancelledById], references: [id], onDelete: Restrict)
  evidence                  ExecutionEvidence[]
  approvedActionVersion     ApprovedActionVersion?         @relation(fields: [approvedActionVersionId], references: [id], onDelete: Restrict)
  governedExecutionTemplate GovernedExecutionTemplate?     @relation(fields: [governedExecutionTemplateId], references: [id], onDelete: Restrict)
  governedTaskTemplate      GovernedExecutionTaskTemplate? @relation(fields: [governedTaskTemplateId], references: [id], onDelete: Restrict)

  @@unique([executionPlanId, sequenceNumber])
  @@unique([executionPlanId, sourceActionCode, templateTaskKey])
  @@index([executionPlanId])
  @@index([status])
  @@index([assignedToId])
  @@index([verifiedById])
  @@index([approvedActionVersionId])
  @@index([governedExecutionTemplateId])
  @@index([governedTaskTemplateId])
}

model ExecutionEvidence {
  id                String                @id @default(uuid())
  executionTaskId   String
  submittedById     String
  evidenceType      ExecutionEvidenceType
  description       String
  referenceUrl      String?
  documentReference String?
  measurementData   Json?
  capturedAt        DateTime?
  submittedAt       DateTime              @default(now())

  executionTask ExecutionTask @relation(fields: [executionTaskId], references: [id], onDelete: Restrict)
  submittedBy   User          @relation(fields: [submittedById], references: [id], onDelete: Restrict)

  @@index([executionTaskId])
  @@index([submittedById])
  @@index([evidenceType])
  @@index([submittedAt])
}

model CaseClosure {
  id                      String            @id @default(uuid())
  caseId                  String            @unique
  executionPlanId         String            @unique
  closedById              String
  closureAuthorityGrantId String
  closureReason           CaseClosureReason
  closureSummary          String
  createdAt               DateTime          @default(now())

  case                  Case              @relation(fields: [caseId], references: [id], onDelete: Restrict)
  executionPlan         ExecutionPlan     @relation(fields: [executionPlanId], references: [id], onDelete: Restrict)
  closedBy              User              @relation("CaseClosureCloser", fields: [closedById], references: [id], onDelete: Restrict)
  closureAuthorityGrant ApprovalAuthority @relation(fields: [closureAuthorityGrantId], references: [id], onDelete: Restrict)

  @@index([closedById])
  @@index([closureAuthorityGrantId])
  @@index([closureReason])
  @@index([createdAt])
}
